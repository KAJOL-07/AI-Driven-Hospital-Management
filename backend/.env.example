# ============================================================
# MediFlow Hospital Management System - Backend Environment Template
# ============================================================
# Duplicate this file as .env and fill in your actual production/local values.
# NEVER commit the real .env file with secrets to version control.

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (MongoDB Atlas Connection URI)
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/hospital_management?retryWrites=true&w=majority

# JWT Authentication Secrets
# Generate a strong 32+ character random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Configuration
# Set to your deployed Vercel frontend URL, e.g. https://your-hospital-frontend.vercel.app
FRONTEND_URL=https://your-frontend-app.vercel.app
CORS_ORIGIN=https://your-frontend-app.vercel.app

# Optional AI / Python Microservice Integration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=3000
